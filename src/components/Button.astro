---
// A link styled as a button.
import Icon from "./Icon.astro";
import type { IconName } from "./icons.ts";

interface Props {
    href: string;
    icon?: IconName;
    /** "primary" is filled, "secondary" is outlined. */
    variant?: "primary" | "secondary";
}

const { href, icon, variant = "primary" } = Astro.props;
---

<a class:list={["button", variant]} href={href}>{icon && <Icon name={icon} />} <slot /></a>

<style>
    .button {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 48px;
        padding: 10px 22px;
        border-radius: 4px;
        border: 2px solid var(--accent);
        font-weight: 700;
        text-decoration: none;
    }

    .primary {
        background: var(--accent);
        color: var(--accent-contrast);
    }

    .secondary {
        background: transparent;
        color: var(--accent);
    }

    .button:hover {
        box-shadow: inset 0 -3px 0 color-mix(in srgb, var(--text) 30%, transparent);
    }
</style>

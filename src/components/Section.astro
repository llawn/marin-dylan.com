---
interface Props {
    id: string;
    title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section">
    <h2>{title}</h2>
    <slot />
</section>

<style>
    .section {
        max-width: var(--prose-width);
        padding: 56px 0;
        border-top: 1px solid var(--rule);
    }

    h2 {
        margin: 0 0 16px;
        font-size: var(--text-heading);
    }

    .section > :global(p) {
        margin: 0;
    }
</style>

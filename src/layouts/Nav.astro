---
// The navigation bar, fixed at the top
// With `autohide`, it hides while the hero shows my name, and comes down once it is out of view.
// Without JavaScript it always shows.

export interface NavLink {
    href: string;
    label: string;
}

interface Props {
    name: string;
    links: readonly NavLink[];
    autohide?: boolean;
}

const { name, links, autohide = false } = Astro.props;
---

<nav class="nav" aria-label="Main" data-autohide={autohide || undefined}>
    <div class="nav-inner">
        <a class="nav-name" href="/">{name}</a>
        <ul class="nav-links">
            {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
    </div>
</nav>

<script>
    // Hidden while my name shows in the hero, down once it is out of view
    const name = document.querySelector("h1");
    for (const nav of document.querySelectorAll<HTMLElement>(".nav[data-autohide]")) {
        if (name) new IntersectionObserver(([entry]) => nav.classList.toggle("nav-hidden", entry!.isIntersecting)).observe(name);
    }
</script>

<style>
    /* Fixed at the top, over the page, slightly see-through */
    .nav {
        position: fixed;
        z-index: 10;
        top: 0;
        right: 0;
        left: 0;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        -webkit-backdrop-filter: blur(8px);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--rule);
        transition: translate 0.25s ease-out;
    }

    /* Always shown when focused */
    :global(.js) .nav-hidden:not(:focus-within) {
        translate: 0 -100%;
    }

    @media (prefers-reduced-motion: reduce) {
        .nav {
            transition: none;
        }
    }

    .nav-inner {
        display: flex;
        align-items: center;
        gap: 24px;
        max-width: var(--page-width);
        height: 56px;
        margin: 0 auto;
        padding: 0 var(--gutter);
    }

    .nav-name {
        margin-right: auto;
        color: var(--text);
        font-weight: 700;
        text-decoration: none;
    }

    .nav-links {
        display: flex;
        gap: 20px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .nav-links a {
        color: var(--text);
        font-weight: 600;
        text-decoration: none;
    }

    .nav-links a:hover,
    .nav-name:hover {
        text-decoration: underline;
    }

    @media (max-width: 720px) {
        .nav-inner {
            gap: 16px;
        }

        .nav-links {
            gap: 14px;
        }
    }
</style>

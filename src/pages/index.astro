---
// The home page: its content (src/content/home.ts) in its sections.
import Button from "../components/Button.astro";
import { home } from "../content/home.ts";
import Base from "../layouts/Base.astro";
import { githubProfile, mailto } from "../lib/links.ts";
import About from "../sections/About.astro";
import Contact from "../sections/Contact.astro";
import Hero from "../sections/Hero.astro";
import { fullName, site } from "../site.ts";

const email = mailto(site.email, home.contact.emailSubject, home.contact.emailBody);
const github = githubProfile(site.githubUser);
const nav = {
    links: [
        { href: "#about", label: home.labels.about },
        { href: "#contact", label: home.labels.contact },
    ],
    autohide: true,
};
---

<Base title={fullName(site.name)} description={home.description} nav={nav}>
    <Hero name={site.name} hero={home.hero}>
        <Button slot="actions" href={email}>{home.labels.emailButton}</Button>
        <Button slot="actions" href={github} variant="secondary">GitHub</Button>
    </Hero>
    <main id="main">
        <About title={home.labels.about} text={home.about} />
    </main>
    <Contact
        title={home.labels.contact}
        links={[
            { href: email, label: site.email },
            { href: github, label: `github.com/${site.githubUser}` },
        ]}
        owner={fullName(site.name)}
    />
</Base>
